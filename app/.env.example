# Скопіюйте в .env (файл .env не потрапляє в Git) або задайте у Netlify:
# Site configuration → Environment variables. Секретів тут немає.

# Публічна адреса сайту БЕЗ слеша в кінці. Використовується для canonical, og:url,
# og:image/twitter:image, JSON-LD, sitemap.xml та рядка Sitemap у robots.txt.
# Поки власного домену немає — залиште порожнім: на Netlify для production збірка візьме
# адресу з вбудованої змінної URL, для preview — з DEPLOY_PRIME_URL.
# Приклад (НЕ реальна адреса): https://example.com
SITE_URL=

# Примусово заборонити індексацію (noindex + Disallow: /), навіть для production.
# Корисно, поки сайт публікується «в тихому режимі». Порожньо або false — вимкнено.
ROBOTS_NOINDEX=
